---
/*
 * PageFinalCta: the compact closing call to action of a subpage, quieter than the home's final CTA. Without props
 * it says what `finalCta` says in the copy.
 */
import type { Locale } from '@data/site';
import { localizedPath } from '@utils/i18n';
import { getCopy } from '@utils/copy';
import { signUpHref } from '@utils/links';
import Reveal from '@components/ui/Reveal.astro';
import Button from '@components/ui/Button.astro';

interface Props {
  locale: Locale;
  title?: string;
  deck?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  primaryHref?: string;
  secondaryHref?: string;
}

const { locale } = Astro.props as Props;
const fallback = getCopy(locale).finalCta;
const {
  title = fallback.h2,
  deck = fallback.deck,
  primaryLabel = fallback.primary,
  secondaryLabel = fallback.secondary,
  primaryHref = signUpHref(locale),
  secondaryHref = localizedPath(locale, '/contact'),
} = Astro.props as Props;
---

<section class="site-pgcta">
  <div class="site-container">
    <Reveal class="site-pgcta__card">
      <h2 class="site-pgcta__title">{title}</h2>
      <p class="site-pgcta__deck">{deck}</p>
      <div class="site-pgcta__actions">
        <Button href={primaryHref} variant="primary" size="md">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="ghost" size="md" iconRight="ic:baseline-arrow-forward">
          {secondaryLabel}
        </Button>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .site-pgcta {
    padding-block: var(--site-section-py-tight);
    background: var(--site-cream);
  }
  :global(.site-pgcta__card) {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px);
    border-radius: var(--site-radius-lg);
    background: var(--site-white);
    border: 1px solid var(--site-ink-100);
    box-shadow: var(--site-shadow-sm);
  }
  .site-pgcta__title {
    margin: 0;
    color: var(--site-ink-900);
    font-family: var(--site-font-display);
    font-size: var(--site-fs-h2);
    font-weight: var(--site-fw-semibold);
    letter-spacing: -0.02em;
    line-height: 1.18;
    max-width: 36rem;
  }
  .site-pgcta__deck {
    margin: 0;
    color: var(--site-ink-500);
    font-size: var(--site-fs-body);
    line-height: 1.6;
    max-width: 36rem;
  }
  .site-pgcta__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
