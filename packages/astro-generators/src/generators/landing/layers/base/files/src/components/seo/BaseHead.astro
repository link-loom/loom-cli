---
import { SITE } from '@data/site';
import { ogLocale } from '@utils/i18n';
import { buildTitle, absoluteUrl, type SeoProps } from '@utils/seo';

interface Props extends SeoProps {}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  noindex = false,
  alternateLocales,
  canonical,
  article,
  locale = SITE.defaultLocale,
} = Astro.props as Props;

const resolvedOgImage = ogImage ?? SITE.ogImage[locale];

const finalTitle = buildTitle(title, locale);
const finalDescription = description ?? SITE.description[locale];
const finalCanonical = canonical ?? Astro.url.href;
const finalOgImage = absoluteUrl(resolvedOgImage);
const primaryOgLocale = ogLocale(locale);
const altOgLocale = locale === 'es' ? 'en_US' : 'es_ES';
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
<meta name="theme-color" content={SITE.themeColor} />

<title>{finalTitle}</title>
<meta name="description" content={finalDescription} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow" />}
<meta name="author" content={SITE.legalName} />

<link rel="canonical" href={finalCanonical} />

{alternateLocales && Object.entries(alternateLocales).map(([loc, path]) => (
  path ? <link rel="alternate" hreflang={loc} href={absoluteUrl(path as string)} /> : null
))}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(`/${SITE.defaultLocale}/`)} />

<!-- Open Graph -->
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={finalCanonical} />
<meta property="og:image" content={finalOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={primaryOgLocale} />
<meta property="og:locale:alternate" content={altOgLocale} />

{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.section && <meta property="article:section" content={article.section} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={finalOgImage} />
{SITE.social.twitterHandle && <meta name="twitter:site" content={SITE.social.twitterHandle} />}

<!-- Icons + manifest -->
<link rel="icon" type="image/svg+xml" href={SITE.brand.mark} />
<link rel="icon" href="/brand/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={SITE.fontsHref} />

<slot name="head-extra" />
