---
import type { Locale } from '@data/site';
import MarketingLayout from '@layouts/MarketingLayout.astro';
import PageFinalCta from '@components/page/PageFinalCta.astro';
import BlogPostMeta from '@components/blog/BlogPostMeta.astro';
import BlogRelated from '@components/blog/BlogRelated.astro';
import ArticleLD from '@components/seo/ArticleLD.astro';
import Reveal from '@components/ui/Reveal.astro';
import { type BlogEntry, postSlug, BLOG_CATEGORY_LABELS } from '@utils/blog';
import { getCopy } from '@utils/copy';

interface Props {
  locale: Locale;
  entry: BlogEntry;
  body: string;
  related: BlogEntry[];
}

const { locale, entry, body, related } = Astro.props as Props;
const { Content } = await entry.render();

const slug = postSlug(entry);
const url = `/${locale}/blog/${slug}`;
const alternateLocales = {
  en: `/en/blog/${slug}`,
  es: `/es/blog/${slug}`,
};

const catLabel = BLOG_CATEGORY_LABELS[entry.data.category][locale];
const t = getCopy(locale).blog;
---

<MarketingLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={entry.data.og_image ?? entry.data.cover_image}
  alternateLocales={alternateLocales}
  article={{
    publishedTime: entry.data.pub_date.toISOString(),
    author: entry.data.author,
    section: catLabel,
    tags: entry.data.tags,
  }}
  breadcrumbFinalLabel={entry.data.title}
>
  <Fragment slot="head-extra">
    <ArticleLD
      headline={entry.data.title}
      description={entry.data.description}
      image={entry.data.og_image ?? entry.data.cover_image}
      datePublished={entry.data.pub_date.toISOString()}
      author={entry.data.author}
      url={url}
      section={catLabel}
      tags={entry.data.tags}
    />
  </Fragment>

  <article class="site-bpost">
    <header class="site-bpost__hero">
      <div class="site-container">
        <Reveal class="site-bpost__hero-block">
          <a class="site-bpost__back site-mono" href={`/${locale}/blog`}>
            ← {t.back}
          </a>
          <BlogPostMeta entry={entry} locale={locale} body={body} />
          <h1 class="site-bpost__title">{entry.data.title}</h1>
          <p class="site-bpost__desc">{entry.data.description}</p>

          {entry.data.tags.length > 0 && (
            <ul class="site-bpost__tags">
              {entry.data.tags.map((tag) => (
                <li class="site-bpost__tag site-mono">#{tag}</li>
              ))}
            </ul>
          )}
        </Reveal>
      </div>
    </header>

    {entry.data.cover_image && (
      <div class="site-container">
        <Reveal class="site-bpost__cover">
          <img src={entry.data.cover_image} alt="" />
        </Reveal>
      </div>
    )}

    <section class="site-bpost__body">
      <div class="site-container">
        <div class="site-bpost__prose">
          <Content />
        </div>
      </div>
    </section>
  </article>

  {related.length > 0 && <BlogRelated locale={locale} posts={related} />}

  <PageFinalCta locale={locale} />
</MarketingLayout>

<style>
  .site-bpost {
    background: var(--site-white);
  }

  .site-bpost__hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(80px, 10vw, 128px) clamp(48px, 6vw, 80px);
  }
  :global(.site-bpost__hero-block) {
    display: grid;
    gap: 16px;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    justify-items: center;
    position: relative;
    z-index: 1;
  }
  .site-bpost__back {
    color: var(--site-ink-500);
    font-size: 11px !important;
    font-weight: var(--site-fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 4px;
    transition: color var(--site-transition-fast);
  }
  .site-bpost__back:hover { color: var(--site-brand-primary); }
  .site-bpost__title {
    margin: 0;
    color: var(--site-ink-900);
    font-family: var(--site-font-display);
    font-size: var(--site-fs-display-lg);
    font-weight: var(--site-fw-semibold);
    letter-spacing: -0.025em;
    line-height: 1.08;
    max-width: 36rem;
  }
  .site-bpost__desc {
    margin: 0;
    color: var(--site-ink-700);
    font-size: var(--site-fs-body-lg);
    line-height: 1.55;
    max-width: 36rem;
  }
  .site-bpost__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 8px;
  }
  .site-bpost__tag {
    padding: 4px 10px;
    border-radius: var(--site-radius-pill);
    background: var(--site-cream);
    color: var(--site-ink-500);
    font-size: 10px !important;
  }

  :global(.site-bpost__cover) {
    max-width: 56rem;
    margin: 0 auto var(--site-space-6);
    border-radius: var(--site-radius-xl);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--site-cream);
  }
  :global(.site-bpost__cover) img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .site-bpost__body {
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .site-bpost__prose {
    max-width: 38rem;
    margin-inline: auto;
    color: var(--site-ink-900);
    font-size: 17px;
    line-height: 1.75;
  }
  .site-bpost__prose :global(h2) {
    margin: 2em 0 0.6em;
    color: var(--site-ink-900);
    font-family: var(--site-font-display);
    font-size: var(--site-fs-h3);
    font-weight: var(--site-fw-semibold);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .site-bpost__prose :global(h3) {
    margin: 1.6em 0 0.5em;
    color: var(--site-ink-900);
    font-family: var(--site-font-display);
    font-size: var(--site-fs-h4);
    font-weight: var(--site-fw-semibold);
    letter-spacing: -0.01em;
  }
  .site-bpost__prose :global(p) {
    margin: 1.1em 0;
    color: var(--site-ink-700);
  }
  .site-bpost__prose :global(a) {
    color: var(--site-brand-primary);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color var(--site-transition-fast);
  }
  .site-bpost__prose :global(a:hover) { color: var(--site-accent); }
  .site-bpost__prose :global(strong) {
    color: var(--site-ink-900);
    font-weight: var(--site-fw-semibold);
  }
  /* The reset removes list markers site-wide; a post's lists get them back. */
  .site-bpost__prose :global(ul),
  .site-bpost__prose :global(ol) {
    padding-left: 1.3em;
    margin: 1.1em 0;
  }
  .site-bpost__prose :global(ul) { list-style: disc; }
  .site-bpost__prose :global(ol) { list-style: decimal; }
  .site-bpost__prose :global(li) {
    margin-bottom: 0.5em;
    color: var(--site-ink-700);
  }
  .site-bpost__prose :global(code) {
    font-family: var(--site-font-mono);
    font-size: 0.9em;
    background: var(--site-cream);
    padding: 2px 6px;
    border-radius: var(--site-radius-sm);
    color: var(--site-brand-primary);
  }
  .site-bpost__prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 8px 0 8px 22px;
    border-left: 3px solid var(--site-accent);
    color: var(--site-ink-700);
    font-style: italic;
  }
</style>
