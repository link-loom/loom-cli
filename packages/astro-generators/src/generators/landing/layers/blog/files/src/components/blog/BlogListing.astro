---
import type { Locale } from '@data/site';
import MarketingLayout from '@layouts/MarketingLayout.astro';
import PageHero from '@components/page/PageHero.astro';
import PageSection from '@components/page/PageSection.astro';
import PageFinalCta from '@components/page/PageFinalCta.astro';
import BlogPostCard from '@components/blog/BlogPostCard.astro';
import BlogCategoryNav from '@components/blog/BlogCategoryNav.astro';
import Reveal from '@components/ui/Reveal.astro';
import { type BlogEntry } from '@utils/blog';
import { getCopy } from '@utils/copy';

interface Props {
  locale: Locale;
  posts: BlogEntry[];
}

const { locale, posts } = Astro.props as Props;
const t = getCopy(locale).blog;

const sorted = [...posts].sort((a, b) => +b.data.pub_date - +a.data.pub_date);
const featured = sorted[0];
const rest = sorted.slice(1);
---

<MarketingLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  alternateLocales={{ en: '/en/blog', es: '/es/blog' }}
>
  <PageHero eyebrow={t.eyebrow} title={t.title} deck={t.deck} />

  <PageSection tone="paper">
    <Reveal class="site-blog__nav">
      <BlogCategoryNav locale={locale} posts={posts} />
    </Reveal>

    {featured && (
      <div class="site-blog__featured-wrap">
        <Reveal class="site-blog__featured">
          <BlogPostCard entry={featured} locale={locale} delay={80} />
        </Reveal>
      </div>
    )}

    {rest.length > 0 ? (
      <div class="site-blog__grid">
        {rest.map((post, i) => (
          <BlogPostCard entry={post} locale={locale} delay={60 * (i + 1)} />
        ))}
      </div>
    ) : (
      <Reveal class="site-blog__empty">
        <p>{t.empty}</p>
      </Reveal>
    )}
  </PageSection>

  <PageFinalCta locale={locale} />
</MarketingLayout>

<script>
  /* The category pills filter the cards in place: ?category=<id> keeps only that category's posts. */
  const category = new URLSearchParams(window.location.search).get('category') ?? '';
  if (category) {
    document.querySelectorAll<HTMLElement>('.site-bcard[data-category]').forEach((card) => {
      card.hidden = card.dataset.category !== category;
    });
    document.querySelectorAll<HTMLElement>('[data-blog-categories] [data-category]').forEach((pill) => {
      pill.classList.toggle('is-active', pill.dataset.category === category);
    });
  }
</script>

<style>
  :global(.site-blog__nav) {
    display: flex;
    justify-content: center;
    margin-bottom: var(--site-space-3);
  }
  :global(.site-blog__featured-wrap) {
    margin-bottom: var(--site-space-3);
  }
  :global(.site-blog__featured) {
    display: grid;
  }
  /* Featured card spans 2 columns when on a wide layout */
  :global(.site-blog__featured .site-bcard) {
    background: linear-gradient(135deg, var(--site-accent-tint) 0%, rgba(48, 187, 183, 0.04) 100%), var(--site-white);
    border-color: rgba(240, 101, 92, 0.3);
  }
  :global(.site-blog__featured .site-bcard__link) {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  :global(.site-blog__featured .site-bcard__cover) {
    aspect-ratio: 4 / 3;
  }
  :global(.site-blog__featured .site-bcard__title) {
    font-size: var(--site-fs-h3);
  }
  @media (max-width: 768px) {
    :global(.site-blog__featured .site-bcard__link) { grid-template-columns: 1fr; }
  }

  .site-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1023px) { .site-blog__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .site-blog__grid { grid-template-columns: 1fr; } }

  :global(.site-blog__empty) {
    display: grid;
    place-items: center;
    padding: clamp(40px, 6vw, 80px) 0;
    color: var(--site-ink-500);
    font-style: italic;
  }
</style>
