{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "link-loom/react-generators/settings-section",
  "title": "Advanced settings card",
  "description": "Adds a card to Advanced settings (src/components/pages/management/home/management.sections.js) with its en/es title and description. The page it opens comes from `add page --section advanced` or `add entity --section advanced`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titleEn", "descriptionEn", "to"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "description": "Card id in kebab-case",
      "x-order": 1
    },
    "titleEn": {
      "type": "string",
      "minLength": 2,
      "description": "Title in English",
      "x-order": 2
    },
    "titleEs": {
      "type": "string",
      "description": "Title in Spanish",
      "x-order": 3
    },
    "descriptionEn": {
      "type": "string",
      "minLength": 2,
      "description": "One sentence in English: what the person manages there",
      "x-order": 4
    },
    "descriptionEs": {
      "type": "string",
      "description": "The same sentence in Spanish",
      "x-order": 5
    },
    "to": {
      "type": "string",
      "pattern": "^/[a-z0-9/:?=&-]*$",
      "description": "Path under the app's base route",
      "x-order": 6
    },
    "icon": {
      "type": "string",
      "enum": [
        "list",
        "inventory",
        "people",
        "folder",
        "document",
        "tag",
        "calendar",
        "cart",
        "task",
        "keys",
        "building",
        "payments",
        "analytics",
        "dashboard",
        "chart",
        "map",
        "mail",
        "security",
        "warehouse",
        "category",
        "today",
        "insights",
        "settings",
        "home",
        "store",
        "receipt",
        "inbox",
        "notifications",
        "help",
        "add",
        "diamond",
        "collections",
        "star"
      ],
      "default": "list",
      "description": "Icon of the card"
    },
    "color": {
      "type": "string",
      "enum": ["brand", "cyan", "coral", "green", "amber", "purple", "blue", "pink"],
      "default": "brand",
      "description": "Card colour, from CARD_COLORS in src/constants/theme.js"
    }
  }
}
