<%_ if (layers.stoneos) { _%>
import { useEffect } from "react";
<%_ } _%>
import { OnPageLoaded, usePageMeta } from "@link-loom/react-sdk";
import { VeripassLogoutSuccess } from "@veripass/react-sdk";
<%_ if (layers.stoneos) { _%>
import { clearAppDataCache } from "@link-loom/cloud-sdk";
<%_ } _%>

import appConfig from "@app-config";
import { useCopy } from "@i18n/index";
import { publicUrl } from "@utils/paths.utils";

/** Ends the session: VeripassLogoutSuccess clears it and offers to sign in again. */
export default function AuthLogoutPage() {
  const copy = useCopy();
  usePageMeta({ title: copy.auth.logout.title });
<%_ if (layers.stoneos) { _%>

  // App Engine apps keep an offline cache per identity: it must not outlive the session.
  useEffect(() => {
    window.dispatchEvent(new Event("veripass::logout"));
    clearAppDataCache();
  }, []);
<%_ } _%>

  return (
    <>
      <section className="col-12 col-md-10 col-lg-6 col-xl-5 mx-auto">
        <VeripassLogoutSuccess
          organization={{ logoSrc: publicUrl(appConfig.brand.logo) }}
          signinUrl={publicUrl("/auth/login")}
          texts={copy.auth.logout.texts}
        />
      </section>
      <OnPageLoaded />
    </>
  );
}
