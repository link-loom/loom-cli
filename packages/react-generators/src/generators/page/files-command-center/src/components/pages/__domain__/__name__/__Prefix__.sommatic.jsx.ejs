import { useSommaticContextSource } from "@sommatic/react-sdk";

export const PAGE_METADATA = {
  path: "<%- basePath %>/<%- routePath %>",
  description: <%- json(`${titleEn} of ${appName}${descriptionEn ? `: ${descriptionEn}` : "."}`) %>,
};

/** Tells the Command Center which page the person is on and what it offers. */
export default function <%- Prefix %>Sommatic() {
  useSommaticContextSource(
    {
      id: "page-context",
      ...PAGE_METADATA,
      getData: () => ({ type: "<%- domain %>-<%- name %>" }),
    },
    []
  );

  return null;
}
