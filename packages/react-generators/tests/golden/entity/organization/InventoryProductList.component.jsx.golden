import { useMemo, useState } from "react";
import { Snackbar } from "@mui/material";
import { AddOutlined as AddIcon } from "@mui/icons-material";
import { ListSurface, NameCell, TextCell, rowActionItems, useDataQuery, useEntityRoute, useListState, useViewMode } from "@link-loom/react-sdk";

import { useCopy, useLocale } from "@i18n/index";
import { iconElement } from "@constants/iconLibrary";
import { appUrl } from "@utils/paths.utils";
import { copyText } from "@utils/clipboard.utils";
import useCurrentUser from "@hooks/useCurrentUser.hook";
import InventoryProductService from "@services/inventory/product/inventory-product.service";
import InventoryProductDialog from "../record/InventoryProductDialog.component";
import InventoryProductQuickActions from "../quick-actions/InventoryProductQuickActions.component";
import { recordPath } from "../inventory-product.utils";

const FILTERS = {};
const ROW_ACTIONS = ["quickview", "open-new-tab", "copy-link", "delete"];
const VIEW_MODES = ["list", "grid"];
const NOTICE_MS = 2500;

/**
 * The products of the person's organization, a page at a time. A row opens the product over the list (?id=); ?new=1 opens the form of a new one.
 */
export default function InventoryProductListComponent() {
  const copy = useCopy();
  const { locale } = useLocale();
  const route = useEntityRoute();
  const list = useListState(FILTERS);
  const { viewMode, setViewMode } = useViewMode({ modes: VIEW_MODES, defaultMode: "list" });
  const { organizationId } = useCurrentUser();
  const service = useMemo(() => new InventoryProductService(), []);
  const [pending, setPending] = useState(null);
  const [notice, setNotice] = useState("");
  const entityCopy = copy.inventory.product;
  const query = useDataQuery(
    () => service.list({ organizationId, ...list.pagination }),
    [organizationId, list.key, list.pagination.page, list.pagination.pageSize],
    { enabled: Boolean(organizationId) }
  );

  const notify = async (text, message) => {
    if (await copyText(text)) {
      setNotice(message);
    }
  };

  const handlers = {
    quickview: (row) => route.openEntity(row.id),
    openNewTab: (row) => window.open(appUrl(recordPath(row.id)), "_blank", "noopener"),
    copyLink: (row) => notify(`${window.location.origin}${appUrl(recordPath(row.id))}`, copy.common.linkCopied),
    remove: (row) => setPending({ action: "delete", record: row }),
  };

  const getActions = (row) => rowActionItems({ actions: ROW_ACTIONS, record: row, handlers, locale });

  const columns = [
    {
      field: "name",
      headerName: entityCopy.fields.name,
      flex: 1,
      minWidth: 200,
      renderCell: ({ row }) => <NameCell title={row.name} untitled={copy.common.untitled} />,
    },
    {
      field: "sku",
      headerName: entityCopy.fields.sku,
      width: 180,
      minContainerWidth: 560,
      renderCell: ({ row }) => <TextCell value={row.sku} />,
    },
  ];

  return (
    <ListSurface
      icon={iconElement("list")}
      title={entityCopy.plural}
      description={entityCopy.description}
      primaryAction={{ id: "create", label: entityCopy.new, icon: <AddIcon />, onClick: () => route.startCreate() }}
      viewMode={viewMode}
      viewModes={VIEW_MODES}
      onViewModeChange={setViewMode}
      query={query}
      pagination={{ ...list.pagination, onChange: list.setPagination }}
      columns={columns}
      getActions={getActions}
      onOpen={(row) => route.openEntity(row.id)}
      card={(row) => ({
        title: row.name,
        meta: [row.sku].filter(Boolean).join(" · "),
        icon: iconElement("list"),
      })}
      filtersActive={list.active}
      onClearFilters={list.clear}
      empty={{
        title: entityCopy.emptyTitle,
        description: entityCopy.emptyDescription,
        filteredTitle: entityCopy.filteredEmptyTitle,
      }}
      untitledLabel={copy.common.untitled}
      locale={locale}
    >
      <InventoryProductDialog onChanged={query.refresh} />
      <InventoryProductQuickActions pending={pending} onClose={() => setPending(null)} onDone={() => query.refresh()} />
      <Snackbar open={Boolean(notice)} message={notice} autoHideDuration={NOTICE_MS} onClose={() => setNotice("")} />
    </ListSurface>
  );
}
