{
  "name": "loom-cli-monorepo",
  "version": "3.0.0-alpha.0",
  "private": true,
  "description": "Link Loom CLI and its generator collections",
  "type": "module",
  "workspaces": [
    "packages/devkit",
    "packages/node-generators",
    "packages/react-generators",
    "packages/astro-generators",
    "packages/migrate",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "version-patch": "node scripts/release.mjs patch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9"
  },
  "repository": "git+https://github.com/link-loom/loom-cli.git",
  "author": "Camilo Alexander Rodriguez Cuaran <camiepisode@outlook.com>",
  "license": "Apache-2.0"
}
